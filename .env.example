# ---------- Banco de dados ----------
# URL do Postgres usada pelo site (no Neon, a conexão "pooled", com -pooler no host).
# Ex.: postgresql://usuario:senha@ep-xxx-pooler.regiao.aws.neon.tech/neondb?sslmode=verify-full
DATABASE_URL=
# Conexão direta (sem -pooler), usada pelas migrações do Prisma. connect_timeout ajuda quando o Neon está "dormindo".
DIRECT_URL=

# ---------- Autenticação (Better Auth) ----------
# Segredo com pelo menos 32 caracteres. Gere com: npx @better-auth/cli secret
BETTER_AUTH_SECRET=
# Endereço público do site (sem barra no final). Ex.: https://gardsoft.com.br
BETTER_AUTH_URL=http://localhost:3000

# ---------- Administrador inicial ----------
# Criado automaticamente quando o banco ainda não tem nenhum usuário.
# Em desenvolvimento, sem estas variáveis, o acesso é admin / admin.
# Em produção, ADMIN_PASSWORD é obrigatória para criar o primeiro acesso.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_EMAIL=admin@gardsoft.local
ADMIN_NAME=Administrador

# ---------- Contatos (valores iniciais) ----------
# Depois do primeiro acesso, edite em /admin/conteudo → "Contatos e redes".
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_LINKEDIN_URL=

# ---------- Financeiro ----------
# Asaas (boleto, Pix, baixa automática e nota fiscal). ASAAS_ENV: sandbox (testes) ou production.
ASAAS_API_KEY=
ASAAS_ENV=sandbox
# Token aleatório; use o mesmo valor no webhook do Asaas (URL: /api/webhooks/asaas).
ASAAS_WEBHOOK_TOKEN=

# Resend (envio de contratos, cobranças e recibos). O domínio do remetente precisa estar verificado.
RESEND_API_KEY=
MAIL_FROM="Gardsoft <contato@seudominio.com.br>"
