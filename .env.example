# ---------- Banco de dados ----------
# URL do Postgres usada pelo site (no Neon, a conexão "pooled", com -pooler no host).
# Ex.: postgresql://usuario:senha@ep-xxx-pooler.regiao.aws.neon.tech/neondb?sslmode=verify-full
DATABASE_URL=
# Conexão direta (sem -pooler), usada pelas migrações do Prisma. connect_timeout ajuda quando o Neon está "dormindo".
DIRECT_URL=

# ---------- Autenticação (Better Auth) ----------
# Segredo com pelo menos 32 caracteres. Gere com: npx @better-auth/cli secret
BETTER_AUTH_SECRET=
# Endereço público do site (sem barra no final). Ex.: https://gardsoft.com.br
BETTER_AUTH_URL=http://localhost:3000

# ---------- Administrador inicial ----------
# Criado automaticamente quando o banco ainda não tem nenhum usuário.
# Em desenvolvimento, sem estas variáveis, o acesso é admin / admin.
# Em produção, ADMIN_PASSWORD é obrigatória para criar o primeiro acesso.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
ADMIN_EMAIL=admin@gardsoft.local
ADMIN_NAME=Administrador

# ---------- Contatos (valores iniciais) ----------
# Depois do primeiro acesso, edite em /admin/conteudo → "Contatos e redes".
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_LINKEDIN_URL=

# ---------- Financeiro ----------
# Asaas (boleto, Pix, baixa automática e nota fiscal). ASAAS_ENV: sandbox (testes) ou production.
ASAAS_API_KEY=
ASAAS_ENV=sandbox
# Token aleatório; use o mesmo valor no webhook do Asaas (URL: /api/webhooks/asaas).
ASAAS_WEBHOOK_TOKEN=

# SMTP (alternativa ao Resend; tem preferência quando preenchido). Gmail: smtp.gmail.com, porta 465,
# SMTP_USER = o e-mail e SMTP_PASS = senha de app (myaccount.google.com/apppasswords, exige verificação em 2 etapas).
# Com SMTP, MAIL_FROM é opcional; no Gmail o remetente precisa ser a própria conta ou um alias dela.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Resend (envio de contratos, cobranças e recibos). O domínio do remetente precisa estar verificado.
# Para testar sem domínio: MAIL_FROM="Gardsoft <onboarding@resend.dev>" (só entrega no e-mail da conta Resend).
RESEND_API_KEY=
MAIL_FROM="Gardsoft <contato@seudominio.com.br>"

# Qual serviço usar quando Resend e SMTP estão configurados: "resend" ou "smtp" (padrão: smtp).
EMAIL_PROVIDER=

# Cloudinary (fotos e vídeos do site). Dados em cloudinary.com → Settings → API Keys.
# Sem estas chaves, as imagens ficam no banco e o envio de vídeos fica desativado.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Pasta onde os arquivos são guardados no Cloudinary (padrão: gardsoft).
CLOUDINARY_FOLDER=gardsoft

# ---------- Tráfego pago: Meta Ads (Facebook e Instagram) ----------
# Token de usuário do sistema (Business Manager) com ads_read, leads_retrieval, pages_show_list,
# pages_read_engagement e pages_manage_metadata. Conta de anúncios: act_123... (ou só os números).
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
# Webhook de Lead Ads (formulários): URL https://SEU-DOMINIO/api/webhooks/meta, campo "leadgen".
META_APP_SECRET=
META_VERIFY_TOKEN=
# Opcional: versão da Graph API (padrão v26.0)
META_GRAPH_VERSION=

# ---------- Tráfego pago: Google Ads ----------
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
# ID da conta de anúncios (123-456-7890) e, se o acesso for por uma conta de administrador (MCC), o ID dela.
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# Opcional: versão da API (padrão v26)
GOOGLE_ADS_API_VERSION=

# ---------- Sincronização diária (Vercel Cron, ver vercel.json) ----------
# Texto aleatório longo; a Vercel envia em "Authorization: Bearer ..." para /api/cron/anuncios.
CRON_SECRET=
